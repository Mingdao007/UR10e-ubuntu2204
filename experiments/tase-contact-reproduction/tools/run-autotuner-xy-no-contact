# These are offline-fixture values only.  A real session always captures Z and
# orientation from its fresh startup/home pose and never substitutes them with
# a source constant.
OFFLINE_FIXTURE_SAFE_Z_M = 0.033000000
OFFLINE_FIXTURE_ORIENTATION_ROTVEC = (3.120752062, 0.0, 0.068626833)
BASE_ORIGIN_XY_M = (0.487795411149049, 0.12932679270060748)
U_ALONG_XY = (-0.010785642631908187, 0.9999418332648238)
P_LATERAL_XY = (-0.9999418332648239, -0.010785642631908406)
PATH_AMPLITUDE_M = 0.015
PATH_OMEGA_RAD_S = 0.1
GUARD_ORDER = ("moving_reference_hard_ellipse", "soft_cbf_qp")


def _same_float_tuple(actual: Sequence[float], expected: Sequence[float]) -> bool:
    return tuple(float(value) for value in actual) == tuple(float(value) for value in expected)


def _validate_canonical_path_binding() -> None:
    basis = R004_PATH_FRAME_SNAPSHOT["basis"]
    if not _same_float_tuple(basis["origin_xy_m"], BASE_ORIGIN_XY_M):
        raise RuntimeError("canonical Step5d XY origin differs")
    if not _same_float_tuple(basis["u_along_xy"], U_ALONG_XY):
        raise RuntimeError("canonical Step5d along basis differs")
    if not _same_float_tuple(basis["p_lateral_xy"], P_LATERAL_XY):
        raise RuntimeError("canonical Step5d lateral basis differs")


_validate_canonical_path_binding()


