            "terminal_stop": self.terminal_stop,
            "reason": self.reason,
            "guard_order": list(GUARD_ORDER),
        }


class DiagnosticTransport(Protocol):
    """The only owner seam needed for later live integration."""

    def session_home_pose(self) -> Pose: ...

    def preposition(self, target: Pose, *, speed_m_s: float, blend_m: float) -> CommandReceipt: ...

    def read_feedback(self, desired: TrajectoryPoint) -> Feedback: ...

    def write_path_command(self, command_twist: Sequence[float]) -> CommandReceipt: ...

    def stop_path(self) -> CommandReceipt: ...

    def return_to_path_origin(self, target: Pose) -> CommandReceipt: ...

    def return_to_session_home(self, target: Pose) -> CommandReceipt: ...

    def verify_stationary(self) -> bool: ...

    def send_zero_abort(self, reason: str) -> CommandReceipt: ...

    def controller_source_identity(self) -> Mapping[str, Any]: ...

    def kunwei_summary(self) -> Mapping[str, Any]: ...

    def kunwei_raw_reference(self) -> Mapping[str, Any]: ...


@dataclass
class OfflineDiagnosticTransport:
    """Deterministic, no-I/O transport for the CLI whole-flow dry run."""

    home: Pose = Pose(
        0.50,
        0.13,
        OFFLINE_FIXTURE_SAFE_Z_M,
        *OFFLINE_FIXTURE_ORIENTATION_ROTVEC,
    )
    tracking_failure_at_s: float | None = None
    operations: list[str] = field(default_factory=list)
    _sequence: int = 0
    _pose: Pose | None = None

    def _receipt(self, operation: str) -> CommandReceipt:
        self._sequence += 1
        self.operations.append(operation)
        return CommandReceipt(operation, self._sequence, self._sequence)

    def session_home_pose(self) -> Pose:
        return self.home

    def preposition(self, target: Pose, *, speed_m_s: float, blend_m: float) -> CommandReceipt:
        if speed_m_s > PREPOSITION_SPEED_MAX_M_S or blend_m != PREPOSITION_BLEND_M:
            return CommandReceipt("preposition", self._sequence, self._sequence, accepted=False)
        self._pose = target
        return self._receipt("preposition")

    def read_feedback(self, desired: TrajectoryPoint) -> Feedback:
        failed = (
            self.tracking_failure_at_s is not None
            and desired.path_time_s >= float(self.tracking_failure_at_s)
        )
        pose = desired.desired_pose
        if failed:
            pose = Pose(
                pose.x_m + 0.010,
                pose.y_m,
                pose.z_m,
                pose.rx_rad,
                pose.ry_rad,
                pose.rz_rad,
            )
        self._pose = pose
        return Feedback(
            actual_pose=pose,
            actual_velocity=(*desired.desired_velocity_xy_m_s, 0.0, 0.0, 0.0, 0.0),
            force_norm_n=0.0,
            torque_norm_nm=0.0,
            qdot_max_abs_rad_s=0.0,
            tracking_ok=not failed,
            fault_reason="offline_tracking_failure" if failed else None,
            ack_seq=self._sequence,
        )

    def write_path_command(self, command_twist: Sequence[float]) -> CommandReceipt:
        if len(tuple(command_twist)) != 6:
            return CommandReceipt("path_command", self._sequence, self._sequence, accepted=False)
        return self._receipt("path_command")

    def stop_path(self) -> CommandReceipt:
        return self._receipt("stop_zero")

    def return_to_path_origin(self, target: Pose) -> CommandReceipt:
        self._pose = target
        return self._receipt("return_path_origin")

    def return_to_session_home(self, target: Pose) -> CommandReceipt:
        self._pose = target
        return self._receipt("return_session_home")

    def verify_stationary(self) -> bool:
        self.operations.append("verify_stationary")
        return True

    def send_zero_abort(self, reason: str) -> CommandReceipt:
        del reason
        return self._receipt("zero_abort")

    def controller_source_identity(self) -> Mapping[str, Any]:
        return {
            "controller": "offline_diagnostic_transport",
            "source": "run-autotuner-xy-no-contact",
            "live_controller_readback": False,
        }

    def kunwei_summary(self) -> Mapping[str, Any]:
        return {
            "source": "offline_zero_force_reference",
            "force_norm_n": 0.0,
            "torque_norm_nm": 0.0,
            "contact_control_active": False,
        }

    def kunwei_raw_reference(self) -> Mapping[str, Any]:
        return {
            "source": "offline_diagnostic_transport",
            "rows": [],
            "preserved": True,
        }


