class OneShotDiagnosticSession:
    """State machine for exactly one PATH and explicit safe return semantics."""

    def __init__(
        self,
        transport: DiagnosticTransport,
        output_dir: Path,
        *,
        limits: SafetyLimits = FAIL_CLOSED_LIMITS,
    ) -> None:
        self.transport = transport
        self.output_dir = Path(output_dir)
        self.limits = limits
        self.phase = SessionPhase.CREATED
        self.path_count = 0
        self.path_sample_count = 0
        self.session_home_pose: Pose | None = None
        self.path_origin_pose: Pose | None = None
        self.last_safety: SafetyDecision | None = None
        self.last_guard: GuardedCommand | None = None
        self.fault_reason: str | None = None
        self.abort_sent = False
        self.return_home_verified = False
        self.tracking_failed = False
        self._terminal_result: RunResult | None = None
        self._rows_written = 0
        self._output_dir_ready = False

    def _write_row(self, writer: csv.DictWriter[str], row: Mapping[str, Any], handle: Any) -> None:
        writer.writerow(dict(row))
        handle.flush()
        self._rows_written += 1
        self.path_sample_count += 1

    def _abort(self, reason: str) -> None:
        self.fault_reason = str(reason)
        if not self.abort_sent:
            self.abort_sent = True
            try:
                self.transport.send_zero_abort(self.fault_reason)
            except Exception:
                # The original zero/abort attempt is retained in evidence;
                # retry/recovery motion is explicitly forbidden.
                pass
        self.phase = SessionPhase.ABORTED

    def _make_row(
        self,
        index: int,
        desired: TrajectoryPoint,
        feedback: Feedback,
        safety: SafetyDecision,
        guarded: GuardedCommand,
        receipt: CommandReceipt,
        fault_reason: str | None = None,
    ) -> dict[str, Any]:
        actual_local = _local_coordinates((feedback.actual_pose.x_m, feedback.actual_pose.y_m))
        return {
            "sample_index": index,
            "t_monotonic_s": desired.path_time_s,
            "path_time_s": desired.path_time_s,
            "phase_rad": desired.phase_rad,
            "desired_base_x_m": desired.desired_pose.x_m,
            "desired_base_y_m": desired.desired_pose.y_m,
            "actual_base_x_m": feedback.actual_pose.x_m,
            "actual_base_y_m": feedback.actual_pose.y_m,
            "desired_local_along_m": desired.local_along_m,
            "desired_local_lateral_m": desired.local_lateral_m,
            "actual_local_along_m": actual_local[0],
            "actual_local_lateral_m": actual_local[1],
            "desired_z_m": desired.desired_pose.z_m,
            "actual_z_m": feedback.actual_pose.z_m,
            "desired_rx_rad": desired.desired_pose.rx_rad,
            "desired_ry_rad": desired.desired_pose.ry_rad,
            "desired_rz_rad": desired.desired_pose.rz_rad,
            "actual_rx_rad": feedback.actual_pose.rx_rad,
            "actual_ry_rad": feedback.actual_pose.ry_rad,
            "actual_rz_rad": feedback.actual_pose.rz_rad,
            "desired_vx_m_s": desired.desired_velocity_xy_m_s[0],
            "desired_vy_m_s": desired.desired_velocity_xy_m_s[1],
            "actual_vx_m_s": feedback.actual_velocity[0],
            "actual_vy_m_s": feedback.actual_velocity[1],
            "actual_vz_m_s": feedback.actual_velocity[2],
            "path_error_along_m": actual_local[0] - desired.local_along_m,
            "path_error_lateral_m": actual_local[1] - desired.local_lateral_m,
            "hard_ellipse_value": guarded.hard_ellipse_value,
            "soft_cbf_qp_active": guarded.soft_cbf_qp_active,
            "guard_order": ">".join(GUARD_ORDER),
            "force_norm_n": safety.force_norm_n,
            "torque_norm_nm": safety.torque_norm_nm,
            "fixed_z_error_m": safety.fixed_z_error_m,
            "orientation_error_rad": safety.orientation_error_rad,
            "command_speed_m_s": safety.command_speed_m_s,
            "qdot_max_abs_rad_s": safety.qdot_max_abs_rad_s,
            "command_vx_m_s": guarded.command_twist[0],
            "command_vy_m_s": guarded.command_twist[1],
            "command_vz_m_s": guarded.command_twist[2],
            "command_seq": receipt.command_seq,
            "ack_seq": receipt.ack_seq,
            "command_ack_ok": receipt.accepted and receipt.command_seq == receipt.ack_seq,
            "rtde_row_json": json.dumps(dict(feedback.rtde_row), sort_keys=True),
            "fault_reason": fault_reason or safety.reason or guarded.reason or "",
        }

    def _write_bundle(self) -> None:
        if not self._output_dir_ready:
            return
        identity = dict(self.transport.controller_source_identity())
        kunwei_summary = dict(self.transport.kunwei_summary())
        kunwei_raw = dict(self.transport.kunwei_raw_reference())
        (self.output_dir / "controller_source_identity.json").write_text(
            json.dumps(identity, indent=2, sort_keys=True) + "\n", encoding="utf-8"
        )
        (self.output_dir / "kunwei_summary.json").write_text(
            json.dumps(kunwei_summary, indent=2, sort_keys=True) + "\n", encoding="utf-8"
        )
        (self.output_dir / "kunwei_raw_reference.json").write_text(
            json.dumps(kunwei_raw, indent=2, sort_keys=True) + "\n", encoding="utf-8"
        )
        evidence = {
            "schema": SCHEMA,
            "claim_class": CLAIM_CLASS,
            "mode": "offline_diagnostic_no_live_claim",
            "path": {
                "stage_id": PATH_STAGE_ID,
                "duration_s": PATH_DURATION_S,
                "sample_rate_hz": SAMPLE_RATE_HZ,
                "sample_period_s": SAMPLE_PERIOD_S,
                "expected_sample_count": EXPECTED_SAMPLE_COUNT,
                "actual_sample_count": self.path_sample_count,
                "one_shot": True,
                "path_count": self.path_count,
                "reference_formula": "theta=0.1*t; along=0.015*(theta-sin(theta)); lateral=0.015*(1-cos(theta))",
                "base_origin_xy_m": list(BASE_ORIGIN_XY_M),
                "u_along_xy": list(U_ALONG_XY),
                "p_lateral_xy": list(P_LATERAL_XY),
                "desired_z_m": None if self.path_origin_pose is None else self.path_origin_pose.z_m,
                "desired_orientation_rotvec": None
                if self.path_origin_pose is None
                else list(self.path_origin_pose.as_tuple()[3:]),
                "reference_speed_max_m_s": 0.003,
            },
            "path_reference_identity": {
                **dict(path_reference_binding()),
                "stage_row_semantic_sha256": BOUND_STAGE_ROW_SEMANTIC_SHA256,
                "frame_semantic_sha256": BOUND_FRAME_SEMANTIC_SHA256,
            },
            "activation": {
                "contact": False,
                "search": False,
                "force_control": False,
                "model": False,
                "candidate": False,
                "training_dataset": False,
                "qualification": False,
                "promotion": False,
                "tell_exact": False,
            },
            "safety_limits": self.limits.as_dict(),
            "guard_order": list(GUARD_ORDER),
            "guard_axes_m": {
                "moving_reference_hard_ellipse": list(R012_HARD_TUBE_AXES_M),
                "soft_cbf_qp": list(R012_SOFT_CBF_AXES_M),
            },
            "lifecycle": {
                "session_home_pose": None
                if self.session_home_pose is None
                else list(self.session_home_pose.as_tuple()),
                "preposition": {
                    "target": None
                    if self.path_origin_pose is None
                    else list(self.path_origin_pose.as_tuple()),
                    "safe_z_m": None
                    if self.path_origin_pose is None
                    else self.path_origin_pose.z_m,
                    "speed_max_m_s": PREPOSITION_SPEED_MAX_M_S,
                    "blend_m": PREPOSITION_BLEND_M,
                },
                "normal_return_order": [
                    "stop_zero",
                    "return_path_origin",
                    "return_session_home",
                    "verify_stationary",
                ],
                "automatic_recovery_motion": False,
                "abort_zero_sent": self.abort_sent,
            },
            "terminal": {
                "state": self.phase.value,
                "fault_reason": self.fault_reason,
                "tracking_failed": self.tracking_failed,
                "return_home_verified": self.return_home_verified,
                "last_safety": None if self.last_safety is None else self.last_safety.as_dict(),
                "last_guard": None if self.last_guard is None else self.last_guard.as_dict(),
            },
            "controller_source_identity": identity,
            "kunwei_summary": kunwei_summary,
            "evidence_files": {
                "rtde_500hz_rows": "rtde_500hz.csv",
                "kunwei_summary": "kunwei_summary.json",
                "kunwei_raw_reference": "kunwei_raw_reference.json",
                "controller_source_identity": "controller_source_identity.json",
                "evidence": "evidence.json",
            },
        }
        (self.output_dir / "evidence.json").write_text(
            json.dumps(evidence, indent=2, sort_keys=True) + "\n", encoding="utf-8"
        )

    def run(self) -> RunResult:
        if self._terminal_result is not None or self.phase in {
            SessionPhase.HOMED,
            SessionPhase.ABORTED,
        }:
            raise OneShotTerminalError("no-contact diagnostic is terminal; a second PATH is forbidden")

        csv_handle = None
        try:
            self.output_dir.mkdir(parents=True, exist_ok=False)
            self._output_dir_ready = True
            csv_handle = (self.output_dir / "rtde_500hz.csv").open(
                "w", newline="", encoding="utf-8"
            )
            writer = csv.DictWriter(csv_handle, fieldnames=CSV_FIELDS)
            writer.writeheader()
            csv_handle.flush()

            self.session_home_pose = self.transport.session_home_pose()
            self.path_origin_pose = Pose(
                BASE_ORIGIN_XY_M[0],
                BASE_ORIGIN_XY_M[1],
                self.session_home_pose.z_m,
                self.session_home_pose.rx_rad,
                self.session_home_pose.ry_rad,
                self.session_home_pose.rz_rad,
            )
            receipt = self.transport.preposition(
                self.path_origin_pose,
                speed_m_s=PREPOSITION_SPEED_MAX_M_S,
                blend_m=PREPOSITION_BLEND_M,
            )
            if not _status_ok(receipt):
                raise RuntimeError("preposition_fault")
            self.phase = SessionPhase.PREPOSITIONED
            guard_stack = R012PathGuardStack()
            self.path_count += 1
            if self.path_count != 1:
                raise OneShotTerminalError("second PATH is forbidden")
            self.phase = SessionPhase.PATH

            for index, path_time_s in enumerate(sample_times_hz()):
                desired = trajectory_at(path_time_s, self.path_origin_pose)
                feedback = self.transport.read_feedback(desired)
                self.tracking_failed = self.tracking_failed or not feedback.tracking_ok
                guarded = guard_path_command(
                    desired, feedback.actual_pose, guard_stack=guard_stack
                )
                self.last_guard = guarded
                safety = evaluate_safety(
                    feedback, desired, guarded.command_twist, self.limits
                )
                self.last_safety = safety
                if not safety.passed:
                    zero = CommandReceipt("zero_abort", receipt.command_seq, feedback.ack_seq)
                    self._write_row(
                        writer,
                        self._make_row(
                            index, desired, feedback, safety, guarded, zero, safety.reason
                        ),
                        csv_handle,
                    )
                    raise RuntimeError(safety.reason or "safety_fault")
                if guarded.terminal_stop:
                    zero = CommandReceipt("zero_abort", receipt.command_seq, feedback.ack_seq)
                    self._write_row(
                        writer,
                        self._make_row(
                            index,
                            desired,
                            feedback,
                            safety,
                            guarded,
                            zero,
                            guarded.reason,
                        ),
                        csv_handle,
                    )
                    raise RuntimeError(guarded.reason or "r012_guard_terminal_stop")
                receipt = self.transport.write_path_command(guarded.command_twist)
                if not _status_ok(receipt):
                    self._write_row(
                        writer,
                        self._make_row(
                            index, desired, feedback, safety, guarded, receipt, "command_ack_fault"
                        ),
                        csv_handle,
                    )
                    raise RuntimeError("command_ack_fault")
                self._write_row(
                    writer, self._make_row(index, desired, feedback, safety, guarded, receipt), csv_handle
                )

            receipt = self.transport.stop_path()
            if not _status_ok(receipt):
                raise RuntimeError("stop_fault")
            self.phase = SessionPhase.STOPPED
            self.phase = SessionPhase.RETURNING_PATH_ORIGIN
            assert self.path_origin_pose is not None
            receipt = self.transport.return_to_path_origin(self.path_origin_pose)
            if not _status_ok(receipt):
                raise RuntimeError("return_path_origin_fault")
            receipt = self.transport.return_to_session_home(self.session_home_pose)
            if not _status_ok(receipt):
                raise RuntimeError("return_session_home_fault")
            self.return_home_verified = bool(self.transport.verify_stationary())
            if not self.return_home_verified:
                raise RuntimeError("stationary_verification_fault")
            self.phase = SessionPhase.HOMED
        except Exception as exc:
            if self.phase != SessionPhase.ABORTED:
                self._abort(str(exc))
        finally:
            if csv_handle is not None:
                csv_handle.close()
            self._write_bundle()

        self._terminal_result = RunResult(
            state=self.phase,
            path_count=self.path_count,
            path_sample_count=self.path_sample_count,
            expected_sample_count=EXPECTED_SAMPLE_COUNT,
            tracking_failed=self.tracking_failed,
            fault_reason=self.fault_reason,
            return_home_verified=self.return_home_verified,
            output_dir=self.output_dir,
        )
        return self._terminal_result


def run_offline_dry_run(output_dir: Path, *, tracking_failure_at_s: float | None = None) -> RunResult:
    transport = OfflineDiagnosticTransport(tracking_failure_at_s=tracking_failure_at_s)
    return OneShotDiagnosticSession(transport, output_dir).run()


def main(argv: Sequence[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--dry-run", action="store_true", help="run the local no-I/O transport")
    parser.add_argument("--live", action="store_true", help="run the dedicated live one-shot diagnostic")
    parser.add_argument("--output-dir", type=Path, required=True)
    parser.add_argument("--tracking-failure-at-s", type=float)
    parser.add_argument("--package-manifest", type=Path)
    parser.add_argument("--readback-manifest", type=Path)
    args = parser.parse_args(list(argv) if argv is not None else None)
    if args.dry_run == args.live:
        parser.error("choose exactly one of --dry-run or --live")
    if args.live:
        if args.package_manifest is None or args.readback_manifest is None:
            parser.error("--live requires --package-manifest and --readback-manifest")
        import sys

        from autotuner_xy_no_contact_live import run_live

        evidence = run_live(
            sys.modules[__name__],
            output_dir=args.output_dir,
            package_manifest=args.package_manifest,
            readback_manifest=args.readback_manifest,
        )
        print(json.dumps({
            "schema": evidence["schema"],
            "claim_class": evidence["claim_class"],
            **evidence["runtime"],
            "output_dir": str(args.output_dir),
        }, sort_keys=True))
        return 0 if evidence["runtime"]["normal_complete"] else 1
    result = run_offline_dry_run(
        args.output_dir, tracking_failure_at_s=args.tracking_failure_at_s
    )
    print(json.dumps(result.as_dict(), sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
