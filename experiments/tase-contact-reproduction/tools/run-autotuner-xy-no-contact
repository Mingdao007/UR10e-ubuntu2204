@dataclass(frozen=True)
class Pose:
    x_m: float
    y_m: float
    z_m: float
    rx_rad: float
    ry_rad: float
    rz_rad: float

    def __post_init__(self) -> None:
        values = (self.x_m, self.y_m, self.z_m, self.rx_rad, self.ry_rad, self.rz_rad)
        if not all(math.isfinite(float(value)) for value in values):
            raise ValueError("pose must contain six finite values")

    @classmethod
    def from_sequence(cls, value: Sequence[float]) -> "Pose":
        if len(value) != 6:
            raise ValueError("pose must contain six values")
        return cls(*(float(item) for item in value))

    def as_tuple(self) -> tuple[float, float, float, float, float, float]:
        return (self.x_m, self.y_m, self.z_m, self.rx_rad, self.ry_rad, self.rz_rad)


@dataclass(frozen=True)
class TrajectoryPoint:
    path_time_s: float
    phase_rad: float
    local_along_m: float
    local_lateral_m: float
    desired_xy_m: tuple[float, float]
    desired_velocity_xy_m_s: tuple[float, float]
    desired_pose: Pose

    @property
    def desired_twist(self) -> tuple[float, float, float, float, float, float]:
        return (*self.desired_velocity_xy_m_s, 0.0, 0.0, 0.0, 0.0)

    @property
    def reference_speed_m_s(self) -> float:
        return math.hypot(*self.desired_velocity_xy_m_s)


@dataclass(frozen=True)
class SafetyLimits:
    max_force_n: float = 6.0
    max_torque_nm: float = 0.5
    max_fixed_z_error_m: float = 0.002
    max_orientation_error_rad: float = math.radians(5.0)
    max_linear_command_speed_m_s: float = 0.004
    max_qdot_rad_s: float = 0.15

    def __post_init__(self) -> None:
        values = (
            self.max_force_n,
            self.max_torque_nm,
            self.max_fixed_z_error_m,
            self.max_orientation_error_rad,
            self.max_linear_command_speed_m_s,
            self.max_qdot_rad_s,
        )
        if not all(math.isfinite(float(value)) and float(value) > 0.0 for value in values):
            raise ValueError("fail-closed safety limits must be finite and positive")

    def as_dict(self) -> dict[str, float]:
        return {
            "max_force_n": self.max_force_n,
            "max_torque_nm": self.max_torque_nm,
            "max_fixed_z_error_m": self.max_fixed_z_error_m,
            "max_orientation_error_rad": self.max_orientation_error_rad,
            "max_orientation_error_deg": math.degrees(self.max_orientation_error_rad),
            "max_linear_command_speed_m_s": self.max_linear_command_speed_m_s,
            "max_qdot_rad_s": self.max_qdot_rad_s,
        }


FAIL_CLOSED_LIMITS = SafetyLimits()


