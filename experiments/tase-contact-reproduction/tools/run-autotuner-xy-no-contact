def _local_coordinates(xy: Sequence[float]) -> tuple[float, float]:
    dx = float(xy[0]) - BASE_ORIGIN_XY_M[0]
    dy = float(xy[1]) - BASE_ORIGIN_XY_M[1]
    return (
        dx * U_ALONG_XY[0] + dy * U_ALONG_XY[1],
        dx * P_LATERAL_XY[0] + dy * P_LATERAL_XY[1],
    )


def _status_ok(receipt: CommandReceipt) -> bool:
    return all(
        (
            receipt.accepted,
            receipt.heartbeat_ok,
            receipt.protocol_ok,
            receipt.joint_mode_ok,
            receipt.receiver_ok,
            receipt.single_live_writer_ok,
        )
    )


