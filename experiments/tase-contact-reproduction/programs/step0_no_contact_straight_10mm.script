# Step0: minimal no-contact straight-line check.
# Boundary: fixed TCP orientation, current-pose start, 10 mm XY line only.
# No Kunwei command, no RTDE input dependency, no TCP/payload write, no zero.

def codex_step0_no_contact_straight_10mm():
  local ux = 0.679764156
  local uy = -0.733430768
  local tangent_speed_m_s = 0.005
  local path_length_m = 0.010
  local runtime_limit_s = 4.0
  local dt = 0.008
  local start_pose = get_actual_tcp_pose()
  local t = 0.0
  local stop_reason = 0.0

  textmsg("codex step0 no-contact straight 10mm start")
  while stop_reason == 0.0:
    local pose_now = get_actual_tcp_pose()
    local dx = pose_now[0] - start_pose[0]
    local dy = pose_now[1] - start_pose[1]
    local progress_m = dx * ux + dy * uy

    write_output_float_register(30, stop_reason)
    write_output_float_register(31, progress_m)
    write_output_float_register(32, 0.0)
    write_output_float_register(33, 0.0)

    if progress_m >= path_length_m:
      stop_reason = 1.0
    elif progress_m < -0.003 or progress_m > 0.012:
      stop_reason = 9.0
    elif t > runtime_limit_s:
      stop_reason = 10.0
    else:
      speedl([ux * tangent_speed_m_s, uy * tangent_speed_m_s, 0.0, 0.0, 0.0, 0.0], 0.03, dt)
      sync()
      t = t + dt
    end
  end
  stopl(0.5)
  write_output_float_register(30, stop_reason)
  textmsg("codex step0 no-contact straight 10mm stop reason:", stop_reason)
end

codex_step0_no_contact_straight_10mm()
