def codex_r006_integer_wire_guard():
  # Integer24/25 are reserved in V5 and are not phase controls.
  local reserved_i24 = read_input_integer_register(24)
  local reserved_i25 = read_input_integer_register(25)
  local latch = read_input_integer_register(26)
  local session_command = read_input_integer_register(27)
  local session_sequence = read_input_integer_register(28)
  local epoch = read_input_integer_register(29)
  local ordinal = read_input_integer_register(30)
  local kind = read_input_integer_register(31)
  local token = read_input_integer_register(32)
  local rollover_command = read_input_integer_register(33)
  local generation = read_input_integer_register(34)
  local early_end = read_input_integer_register(35)
  local next_ordinal = read_input_integer_register(36)
  local next_kind = read_input_integer_register(37)
  local next_token = read_input_integer_register(38)
  local qdot_generation = read_input_integer_register(39)
  if reserved_i24 < 0 or reserved_i25 < 0:
    return 67
  elif latch < 0 or latch > 1:
    return 52
  elif session_command < 0 or session_command > 3:
    return 66
  elif session_sequence < 0 or epoch < 0 or ordinal < 0 or token < 0:
    return 67
  elif session_command != 0 and (kind < 10 or kind > 15):
    return 67
  elif rollover_command < 0 or rollover_command > 3:
    return 67
  elif generation < 0 or early_end < 0 or next_ordinal < 0 or next_kind < 0 or next_token < 0 or qdot_generation < 0:
    return 67
  elif next_kind != 0 and (next_kind < 10 or next_kind > 15):
    return 67
  elif rollover_command == 1 and (generation <= 0 or next_ordinal <= 0 or next_kind == 0 or next_token <= 0 or qdot_generation != 0):
    return 67
  elif rollover_command == 2 and (generation <= 0 or next_ordinal <= 0 or next_kind == 0 or next_token <= 0 or qdot_generation != generation):
    return 67
  elif rollover_command == 3 and (generation <= 0 or next_ordinal != 0 or next_kind != 0 or next_token != 0 or qdot_generation != 0):
    return 67
  end
  return 0
end

def codex_r006_qdot_ok():
  local index = 0
  while index < 6:
    local qdot = read_input_float_register(37 + index)
    if not codex_r006_finite(qdot, 5.000000000):
      return False
    end
    index = index + 1
  end
  return True
end

def codex_r006_packet_guard(packet_reason, abs_normal_limit, force_norm_limit, torque_limit):
  if packet_reason != 0:
    return packet_reason
  elif read_input_float_register(27) < 0.5 or read_input_float_register(29) < 0.5:
    return 3
  elif read_input_float_register(28) > 0.5:
    return 4
  elif read_input_integer_register(27) == 3:
    return 4
  elif read_input_integer_register(27) != 0 and read_input_integer_register(27) != 1 and read_input_integer_register(27) != 2 and read_input_integer_register(27) != 3:
    return 66
  elif codex_r006_abs(read_input_float_register(24)) >= abs_normal_limit:
    return 5
  elif read_input_float_register(25) >= force_norm_limit:
    return 6
  elif read_input_float_register(30) >= torque_limit:
    return 7
  elif read_input_float_register(44) < 1.0 or read_input_float_register(44) > 5.0:
    return 49
  elif not codex_r006_qdot_ok():
    return 45
  end
  return 0
end
def codex_r006_stationary(required_s):
  local dwell_s = 0.0
  local elapsed_s = 0.0
  # A blocking move may expose one deceleration sample after it returns.
  # Keep the existing speed thresholds and require the full dwell, but allow
  # at most four dwell-windows for that residual motion to settle.  With the
  # fixed 250 ms call sites this is a 1.0 s settle plus 250 ms full dwell.
  while dwell_s < required_s and elapsed_s < required_s * 5.0:
    local packet_reason = codex_r006_packet_observe()
    local guard = codex_r006_packet_guard(packet_reason, 60.0, 100.0, 3.0)
    local speed = get_actual_tcp_speed()
    local linear = sqrt(speed[0] * speed[0] + speed[1] * speed[1] + speed[2] * speed[2])
    local angular = sqrt(speed[3] * speed[3] + speed[4] * speed[4] + speed[5] * speed[5])
    if guard != 0:
      return False
    elif linear > 0.000500000 or angular > 0.005000000:
      dwell_s = 0.0
    else:
      dwell_s = dwell_s + get_steptime()
    end
    elapsed_s = elapsed_s + get_steptime()
    sync()
  end
  return dwell_s >= required_s
end

def codex_r006_pose_close(actual, expected):
  local position_error = sqrt((actual[0] - expected[0]) * (actual[0] - expected[0]) + (actual[1] - expected[1]) * (actual[1] - expected[1]) + (actual[2] - expected[2]) * (actual[2] - expected[2]))
  local rotation_error = sqrt((actual[3] - expected[3]) * (actual[3] - expected[3]) + (actual[4] - expected[4]) * (actual[4] - expected[4]) + (actual[5] - expected[5]) * (actual[5] - expected[5]))
  return position_error <= 0.001000000 and rotation_error <= 0.010000000
end

def codex_r006_q_close(actual, expected):
  local index = 0
  while index < 6:
    if not codex_r006_finite(actual[index], 1000000.0) or not codex_r006_finite(expected[index], 1000000.0):
      return False
    elif codex_r006_abs(actual[index] - expected[index]) > 0.020000000:
      return False
    end
    index = index + 1
  end
  return True
end

def codex_r006_home_close(expected_pose, expected_q):
  local actual_pose = get_actual_tcp_pose()
  if not codex_r006_pose_close(actual_pose, expected_pose):
    return False
  end
  local actual_q = get_actual_joint_positions()
  if not codex_r006_q_close(actual_q, expected_q):
    return False
  end
  return True
end

def codex_r006_entry_home_verified(expected_pose, locked_q, locked_q_valid):
  # The Cartesian check is authoritative.  Only after it passes may the
  # current q establish or be compared with the resident IK branch.
  local actual_pose = get_actual_tcp_pose()
  if not codex_r006_pose_close(actual_pose, expected_pose):
    return False
  end
  local actual_q = get_actual_joint_positions()
  if not codex_r006_q_close(actual_q, actual_q):
    return False
  elif locked_q_valid and not codex_r006_q_close(actual_q, locked_q):
    return False
  end
  return True
end

def codex_v5_stop_requested():
  return read_input_integer_register(27) == 3 or read_input_float_register(28) > 0.5
end

def codex_v5_switch_gate_families(hard_safety_gate, timing_freshness_gate, tube_cbf_gate, identity_metric_closure_gate, command_envelope_gate):
  # Every family is evaluated by the resident tick before this pure combiner.
  return hard_safety_gate and timing_freshness_gate and tube_cbf_gate and identity_metric_closure_gate and command_envelope_gate
end

def codex_r006_echo(epoch, ordinal, state, token, reason, consumed, kind, return_guard, runtime_revision, runtime_extension):
  # V5 writes only output integer24..34; the overlay interpretation is state-dependent.
