# Step3-0C: no-motion 500 Hz isolation with get_actual_tcp_pose plus filter/control math.
# VERSION: 2026-06-08T1137HKT_STEP3_0C_POSE_MATH_500HZ_V1
# GENERATED_AT_LOCAL: 2026-06-08T11:37:47+0800
# BEHAVIOR: wait for Kunwei bridge/RTDE input registers; each 2 ms loop reads
# input_double_register_24..36, calls get_actual_tcp_pose(), runs the Step2C-like
# normal-force filter and PI math, then echoes data to output registers.
# NO MOTION: no speedl, no movel, no stopl, no zero_ftsensor, no Kunwei tare,
# no TCP/payload write, no UR-side force mode.
# PURPOSE: isolate whether URScript register reads + get_actual_tcp_pose() +
# controller math can sustain a 500 Hz echo cadence before testing speedl.

def codex_abs(x):
  if x < 0.0:
    return -x
  end
  return x
end

def codex_clamp(x, lo, hi):
  if x < lo:
    return lo
  elif x > hi:
    return hi
  end
  return x
end

def codex_wait_for_sensor_ok(timeout_s):
  local dt = 0.002
  local t = 0.0
  while t < timeout_s:
    if read_input_float_register(27) > 0.5:
      return True
    end
    sync()
    t = t + dt
  end
  return False
end

def codex_step3_0c_pose_math_500hz():
  local dt = 0.002
  local runtime_s = 120.0
  local t = 0.0
  local loop_counter = 0.0
  local stop_reason = 0.0
  local filtered_normal_force = 0.0
  local integral_error = 0.0
  local alpha = 0.70
  local kp = 0.0006
  local ki = 0.00008
  local normal_velocity_limit = 0.005
  local integral_limit = 10.0
  local target_force_abs_default = 5.0

  textmsg("codex step3-0c pose math version 2026-06-08T1137HKT_STEP3_0C_POSE_MATH_500HZ_V1 start")

  if not codex_wait_for_sensor_ok(30.0):
    stop_reason = 3.0
  end

  while t < runtime_s and stop_reason == 0.0:
    local normal_force = read_input_float_register(24)
    local force_norm = read_input_float_register(25)
    local heartbeat = read_input_float_register(26)
    local sensor_ok = read_input_float_register(27)
    local stop_request = read_input_float_register(28)
    local target_force_abs = read_input_float_register(29)
    local torque_norm = read_input_float_register(30)
    local fx = read_input_float_register(31)
    local fy = read_input_float_register(32)
    local fz = read_input_float_register(33)
    local mx = read_input_float_register(34)
    local my = read_input_float_register(35)
    local mz = read_input_float_register(36)

    local pose_now = get_actual_tcp_pose()
    local pose_checksum = pose_now[0] + pose_now[1] + pose_now[2] + pose_now[3] + pose_now[4] + pose_now[5]

    if target_force_abs <= 0.0:
      target_force_abs = target_force_abs_default
    end

    filtered_normal_force = alpha * normal_force + (1.0 - alpha) * filtered_normal_force
    local force_error = target_force_abs + filtered_normal_force
    integral_error = codex_clamp(integral_error + force_error * dt, -integral_limit, integral_limit)
    local normal_velocity = codex_clamp(kp * force_error + ki * integral_error, -normal_velocity_limit, normal_velocity_limit)

    if sensor_ok < 0.5:
      stop_reason = 3.0
    elif stop_request > 0.5:
      stop_reason = 4.0
    elif codex_abs(normal_force) > 20.0:
      stop_reason = 5.0
    elif force_norm > 50.0:
      stop_reason = 6.0
    elif torque_norm > 0.6:
      stop_reason = 7.0
    end

    write_output_float_register(24, normal_force)
    write_output_float_register(25, force_norm)
    write_output_float_register(26, heartbeat)
    write_output_float_register(27, sensor_ok)
    write_output_float_register(28, stop_request)
    write_output_float_register(29, target_force_abs)
    write_output_float_register(30, stop_reason)
    write_output_float_register(31, filtered_normal_force)
    write_output_float_register(32, force_error)
    write_output_float_register(33, normal_velocity)
    write_output_float_register(34, pose_checksum)
    write_output_float_register(35, loop_counter)

    sync()
    loop_counter = loop_counter + 1.0
    t = t + dt
  end

  write_output_float_register(30, stop_reason)
  textmsg("codex step3-0c pose math version 2026-06-08T1137HKT_STEP3_0C_POSE_MATH_500HZ_V1 stop reason:", stop_reason)
end

codex_step3_0c_pose_math_500hz()
