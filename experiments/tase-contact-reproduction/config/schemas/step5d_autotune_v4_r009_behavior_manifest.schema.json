{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "step5d.autotune-v4/r009-behavior-manifest-v1",
  "title": "Step5d Autotune V4 R009 behavior manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "program",
    "lineage",
    "parent_r006_contract_sha256",
    "parent_r006_source_closure_sha256",
    "r009_source_closure_sha256",
    "source_closure",
    "contact_search_schedule",
    "raw_codec",
    "objective_semantic_fingerprint",
    "runtime_protocol",
    "executable_behavior_config"
  ],
  "properties": {
    "schema": {"const": "step5d.autotune-v4/r009-behavior-manifest-v1"},
    "version": {"const": "r009-v1"},
    "program": {"const": "step5d_strict_rnn_autotune_v4_r009"},
    "lineage": {"const": "step5d_strict_rnn_autotune_v4"},
    "parent_r006_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parent_r006_source_closure_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "r009_source_closure_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_closure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "files", "sha256"],
      "properties": {
        "schema": {"const": "step5d.autotune-v4/r009-source-set-v1"},
        "files": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "contact_search_schedule": {"type": "object", "minProperties": 1},
    "raw_codec": {"type": "string", "minLength": 1},
    "objective_semantic_fingerprint": {"type": "string", "minLength": 1},
    "runtime_protocol": {"type": "integer", "minimum": 1},
    "executable_behavior_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version", "values"],
      "properties": {
        "schema": {"const": "step5d.autotune-v4/r009-executable-behavior-v1"},
        "version": {"const": "r009-behavior-v1"},
        "values": {
          "type": "object",
          "required": ["observability"],
          "properties": {
            "observability": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "schema", "version", "hot_path_hz", "retention_s",
                "ring_capacity_rows", "disk_sample_hz", "queue_max_rows",
                "batch_max_rows", "batch_max_wait_s", "attempt_cap_bytes",
                "run_cap_bytes", "stop_tail_rows", "observer_poll_interval_s",
                "freshness_ttl_formula", "stop_states", "state20_filename",
                "state25_filename", "audit_schema"
              ],
              "properties": {
                "schema": {"const": "step5d.autotune-v4/r009-observability-v1"},
                "version": {"const": "r009-observability-v1"},
                "hot_path_hz": {"type": "integer", "minimum": 1},
                "retention_s": {"type": "number", "exclusiveMinimum": 0},
                "ring_capacity_rows": {"type": "integer", "minimum": 1},
                "disk_sample_hz": {"type": "integer", "minimum": 1},
                "queue_max_rows": {"type": "integer", "minimum": 1},
                "batch_max_rows": {"type": "integer", "minimum": 1},
                "batch_max_wait_s": {"type": "number", "exclusiveMinimum": 0},
                "attempt_cap_bytes": {"type": "integer", "minimum": 1},
                "run_cap_bytes": {"type": "integer", "minimum": 1},
                "stop_tail_rows": {"type": "integer", "minimum": 1},
                "observer_poll_interval_s": {"type": "number", "exclusiveMinimum": 0},
                "freshness_ttl_formula": {"const": "max(3*poll_interval_s,5.0)"},
                "stop_states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
                "state20_filename": {"type": "string", "minLength": 1},
                "state25_filename": {"type": "string", "minLength": 1},
                "audit_schema": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
