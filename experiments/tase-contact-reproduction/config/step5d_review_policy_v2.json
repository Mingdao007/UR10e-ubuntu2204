{
  "schema_version": "ur10e_review_policy_v2",
  "policy_id": "ur10e_review_policy_v2",
  "defaults": {
    "codex": {
      "model": "gpt-5.6-sol",
      "reasoning_effort": "high"
    },
    "fable5": {
      "model": "claude-fable-5",
      "reasoning_effort": "high"
    }
  },
  "execution": {
    "evidence_freeze_required": true,
    "full_review_limit_per_composite_fingerprint": 1,
    "lane_timeout_seconds": 720,
    "lane_attempt_limit": 1,
    "target_total_wall_seconds": 900,
    "lanes_run_in_parallel": true,
    "max_focused_tests_per_lane": 3,
    "reviewer_access": "read_only",
    "reviewer_scan_scope": "lane_packet_allowlist_changed_hunks_and_focused_tests_only",
    "timeout_disposition": "unavailable",
    "automatic_timeout_restart": false,
    "ordinary_work_produces_reviewer_invocation": false,
    "targeted_closer_is_default_after_finding_fix": true
  },
  "severity": {
    "P0": {
      "blocks": true,
      "closure": "targeted_closer_required"
    },
    "P1": {
      "blocks": true,
      "closure": "targeted_closer_required"
    },
    "P2": {
      "blocks": false,
      "closure": "backlog_reference_or_closed"
    }
  },
  "max_escalation_flags": [
    "torque_control",
    "major_safety_change",
    "major_force_frame_change",
    "reviewer_disagreement",
    "final_reproduction_claim",
    "explicit_user_max"
  ],
  "fingerprint_invalidation": {
    "code": "reselect_full_stack_when_control_or_safety_scope_changes",
    "package": "reselect_full_pre_live_stack",
    "evidence": "target_only_affected_evidence_or_claim_lane_when_code_and_package_are_unchanged",
    "policy": "reselect_full_stack"
  },
  "waiver": {
    "allowed_provider": "fable5",
    "allowed_lane": "physical_operator_safety",
    "requires_explicit_user_authorization": true,
    "requires_composite_fingerprint_binding": true,
    "scope": "one_missing_fable5_lane_for_one_fingerprint",
    "never_waives_live_or_contact_authorization": true
  },
  "fable5_preflight_statuses": [
    "available",
    "unavailable_error",
    "unavailable_not_installed",
    "unavailable_not_logged_in"
  ],
  "workflow_milestone_map": {
    "ordinary": {
      "development": "ordinary_development",
      "handoff": "ordinary_handoff"
    },
    "direction_change": {
      "evidence_freeze": "direction_change"
    },
    "p0_v8": {
      "pre_live": "p0_v8_pre_live",
      "post_run": "p0_v8_post_run"
    },
    "v29": {
      "baseline_re_review": "v29_baseline_re_review",
      "contact_pre_live": "v29_contact_pre_live",
      "post_run": "contact_post_run"
    },
    "v30": {
      "contact_pre_live": "v30_contact_pre_live",
      "post_run": "contact_post_run"
    }
  },
  "review_classes": {
    "ordinary_development": {
      "stack": "0+0",
      "full_review_required": false,
      "lanes": []
    },
    "ordinary_handoff": {
      "stack": "0+0",
      "full_review_required": false,
      "lanes": []
    },
    "direction_change": {
      "stack": "1+0",
      "full_review_required": true,
      "merge_into_pending_pre_live_review": true,
      "required_evidence_roles": [
        "deterministic_validation"
      ],
      "lanes": [
        "control_claim"
      ]
    },
    "p0_v8_pre_live": {
      "stack": "1+1",
      "full_review_required": true,
      "requires_package_identity": true,
      "required_evidence_roles": [
        "package_readback",
        "safe_hold",
        "timing"
      ],
      "lanes": [
        "control_timing_claim",
        "physical_operator_safety"
      ]
    },
    "v29_contact_pre_live": {
      "stack": "2+1",
      "full_review_required": true,
      "requires_package_identity": true,
      "required_evidence_roles": [
        "package_readback",
        "readiness",
        "safe_hold",
        "timing"
      ],
      "lanes": [
        "control_claim",
        "timing_runtime",
        "physical_operator_safety"
      ]
    },
    "v30_contact_pre_live": {
      "stack": "2+1",
      "full_review_required": true,
      "requires_package_identity": true,
      "required_evidence_roles": [
        "p0_v8_pass",
        "package_readback",
        "readiness",
        "safe_hold",
        "timing"
      ],
      "lanes": [
        "control_claim",
        "timing_runtime",
        "physical_operator_safety"
      ]
    },
    "p0_v8_post_run": {
      "stack": "1+0",
      "full_review_required": true,
      "reuse_pre_live_code_review": true,
      "required_evidence_roles": [
        "deterministic_verifier",
        "run_artifact"
      ],
      "lanes": [
        "run_evidence_claim"
      ]
    },
    "contact_post_run": {
      "stack": "1+1",
      "full_review_required": true,
      "reuse_pre_live_code_review": true,
      "required_evidence_roles": [
        "deterministic_verifier",
        "run_artifact"
      ],
      "lanes": [
        "run_evidence_claim",
        "physical_operator_safety"
      ]
    },
    "v29_baseline_re_review": {
      "stack": "1+0",
      "full_review_required": true,
      "required_evidence_roles": [
        "portable_evidence"
      ],
      "lanes": [
        "control_claim"
      ]
    }
  },
  "lanes": {
    "control_claim": {
      "provider": "codex",
      "file_globs": [
        "tools/*control*",
        "tools/*bridge*",
        "tools/*solver*",
        "config/*evidence*",
        "config/*replay*",
        "config/*stage*",
        "config/*readiness*",
        "programs/step5/step5d/*"
      ]
    },
    "control_timing_claim": {
      "provider": "codex",
      "file_globs": [
        "tools/*control*",
        "tools/*bridge*",
        "tools/*solver*",
        "tools/*timing*",
        "tools/*p0*",
        "config/*stage*",
        "config/*timing*",
        "config/*readiness*",
        "programs/step5/step5d/*"
      ]
    },
    "timing_runtime": {
      "provider": "codex",
      "file_globs": [
        "tools/*timing*",
        "tools/*runtime*",
        "tools/*bridge*",
        "config/*timing*",
        "config/*readiness*"
      ]
    },
    "physical_operator_safety": {
      "provider": "fable5",
      "file_globs": [
        "scripts/*operator*",
        "scripts/*p0*",
        "tools/*bridge*",
        "tools/*safety*",
        "config/*stage*",
        "config/*authorization*",
        "programs/step5/step5d/*"
      ]
    },
    "run_evidence_claim": {
      "provider": "codex",
      "file_globs": [
        "tools/*analy*",
        "tools/*verif*",
        "config/*readiness*",
        "runs/*"
      ]
    }
  },
  "claim_boundaries": [
    "package_accepted",
    "live_accepted",
    "reproduction_complete"
  ]
}
