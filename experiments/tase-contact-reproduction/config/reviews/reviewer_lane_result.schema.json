{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ur10e:reviewer-lane-result-v2",
  "title": "UR10e Review v2 lane result",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": ["pass", "block", "unavailable", "unavailable_timeout"]
    },
    "verdict": {
      "enum": ["pass", "block", "unavailable", "unavailable_timeout"]
    },
    "requested_model": {"type": "string", "minLength": 1},
    "requested_effort": {"enum": ["high", "max"]},
    "actual_model": {"type": ["string", "null"]},
    "actual_effort": {"type": ["string", "null"]},
    "effort_escalation_reasons": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "timeout_seconds": {"type": "integer", "minimum": 1},
    "elapsed_seconds": {"type": "number", "minimum": 0},
    "attempt_count": {"const": 1},
    "automatic_restart": {"const": false},
    "timeout_disposition": {
      "type": ["string", "null"],
      "enum": ["unavailable", null]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "severity": {"enum": ["P0", "P1", "P2"]},
          "status": {"enum": ["open", "backlog", "closed"]},
          "title": {"type": "string"},
          "evidence": {"type": "string"},
          "resolution": {"type": ["string", "null"]},
          "backlog_ref": {"type": ["string", "null"]}
        },
        "required": [
          "id", "severity", "status", "title", "evidence",
          "resolution", "backlog_ref"
        ]
      }
    },
    "summary": {"type": "string"},
    "invocation_id": {"type": "string"},
    "packet_path": {"type": "string"},
    "packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "raw_output_path": {"type": "string"},
    "raw_output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scope_note": {"type": "string"}
  },
  "required": [
    "status", "verdict", "requested_model", "requested_effort",
    "actual_model", "actual_effort", "effort_escalation_reasons",
    "timeout_seconds", "elapsed_seconds", "attempt_count",
    "automatic_restart", "findings", "summary"
  ],
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "pass"}}},
      "then": {
        "properties": {
          "verdict": {"const": "pass"},
          "actual_model": {"type": "string", "minLength": 1},
          "actual_effort": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "unavailable_timeout"}}},
      "then": {
        "properties": {
          "verdict": {"const": "unavailable_timeout"},
          "timeout_disposition": {"const": "unavailable"}
        },
        "required": ["timeout_disposition"]
      }
    }
  ]
}
