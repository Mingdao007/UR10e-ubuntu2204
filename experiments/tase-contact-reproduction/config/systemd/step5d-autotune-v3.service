[Unit]
Description=Step5d Autotune v3 offline control plane
Documentation=file:%h/.local/bin/step5d-autotune-v3.sh

[Service]
Type=simple
ExecStart=%h/.local/bin/step5d-autotune-v3.sh --_service
Restart=no
KillMode=control-group
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any

[Install]
WantedBy=default.target
