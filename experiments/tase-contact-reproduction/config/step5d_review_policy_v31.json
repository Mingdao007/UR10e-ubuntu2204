{
  "schema_version": "ur10e_review_policy_v3",
  "policy_id": "ur10e_review_policy_v31_sol_high",
  "execution": {
    "ordinary_work_produces_reviewer_invocation": false,
    "full_review_limit_per_composite_fingerprint": 1,
    "formal_review_rounds_per_work_item": 1,
    "finding_fix_closure": "deterministic_owner_validation_no_reviewer",
    "lanes_run_in_parallel": true,
    "review_lanes_have_wall_clock_timeout": false,
    "fable5_degraded_statuses": ["skipped_unavailable"],
    "degraded_effective_stack": "1+0",
    "codex_lane_may_degrade": false
  },
  "severity": {
    "P0": {"blocks": true, "closure": "deterministic_owner_validation_required"},
    "P1": {"blocks": true, "closure": "deterministic_owner_validation_required"},
    "P2": {"blocks": false, "closure": "backlog"}
  },
  "workflow_milestone_map": {
    "v31": {"contact_pre_live": "contact_pre_live", "post_run": "ordinary_zero"}
  },
  "review_classes": {
    "ordinary_zero": {
      "stack": "0+0",
      "full_review_required": false,
      "lanes": []
    },
    "contact_pre_live": {
      "stack": "1+1",
      "full_review_required": true,
      "evidence_freeze_required": true,
      "requires_package_identity": true,
      "lanes": ["control_timing_claim", "physical_operator_safety"]
    }
  },
  "lanes": {
    "control_timing_claim": {
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "effort": "high",
      "required": true
    },
    "physical_operator_safety": {
      "provider": "fable5",
      "model": "claude-fable-5",
      "effort": "high",
      "required": true
    }
  },
  "authorization_boundary": {
    "deterministic_live_gates_never_degrade": true,
    "explicit_user_live_contact_authorization_never_degrades": true,
    "tailscale_realtime_control_allowed": false
  }
}
