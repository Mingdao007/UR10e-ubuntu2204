# Step1: full no-contact pipeline dry run.
# VERSION: 2026-06-05T00:52:09+08:00
# BEHAVIOR: no output_register_34 zero request; move reference XY start at
# current Z; descend 50 mm in base Z; run full 63.58 mm XY line; retract +50 mm;
# uses movel for all Step1 geometry moves. Step2 will tune speedl separately.
# This is the final contact-run scaffold without contact search or force
# control. It requires the Python Kunwei RTDE bridge to be running.
#
# Boundary:
# - fixed TCP orientation unless use_reference_orientation is set to 1
# - move to reference XY start at current Z, never to the old contact Z
# - software zero request only, no UR zero_ftsensor and no Kunwei tare
# - no z-down search and no normal-force correction

def codex_abs(x):
  if x < 0.0:
    return -x
  end
  return x
end

def codex_wait_for_sensor_ok(timeout_s):
  local dt = 0.008
  local t = 0.0
  while t < timeout_s:
    if read_input_float_register(27) > 0.5:
      return True
    end
    sync()
    t = t + dt
  end
  return False
end

def codex_guard_ok():
  local normal_force = read_input_float_register(24)
  local force_norm = read_input_float_register(25)
  local sensor_ok = read_input_float_register(27)
  local stop_request = read_input_float_register(28)
  local torque_norm = read_input_float_register(30)
  if sensor_ok < 0.5:
    return False
  elif stop_request > 0.5:
    return False
  elif codex_abs(normal_force) > 12.0:
    return False
  elif force_norm > 15.0:
    return False
  elif torque_norm > 0.6:
    return False
  end
  return True
end

def codex_step1_full_no_contact_pipeline():
  local ux = 0.679764156
  local uy = -0.733430768
  local path_start_x = 0.446585764
  local path_start_y = 0.226717001
  local ref_rx = 3.141572714
  local ref_ry = -0.000026465
  local ref_rz = -0.000024158
  local use_reference_orientation = 0
  local approach_speed_m_s = 0.010
  local search_down_m = 0.050
  local search_speed_m_s = 0.005
  local tangent_speed_m_s = 0.005
  local path_length_m = 0.06358
  local retract_z_m = 0.050
  local retract_speed_m_s = 0.005
  local dt = 0.008
  local stop_reason = 0.0

  textmsg("codex step1 version 2026-06-05T00:52:09+08:00 no-reg34 movel z-down50 line63p58 z-up50 start")

  # 0. Sensor stream and initial software zero must already be good.
  write_output_float_register(35, 0.0)
  if not codex_wait_for_sensor_ok(3.0):
    stop_reason = 3.0
  end

  # 1. Move to target path start XY at current Z. Orientation correction is
  # intentionally gated by use_reference_orientation.
  if stop_reason == 0.0:
    write_output_float_register(35, 1.0)
    local p0 = get_actual_tcp_pose()
    local target_start = p[path_start_x, path_start_y, p0[2], p0[3], p0[4], p0[5]]
    if use_reference_orientation > 0.5:
      target_start = p[path_start_x, path_start_y, p0[2], ref_rx, ref_ry, ref_rz]
    end
    movel(target_start, a=0.030, v=approach_speed_m_s, r=0.0)
    stopl(0.5)
  end

  # 2. Settle at the path start. Do not request a second software zero here:
  # output register 34 is reserved for explicit zero requests and stale/cached
  # values can cause repeated bridge re-zeroing.
  if stop_reason == 0.0:
    write_output_float_register(35, 2.0)
    sleep(0.20)
    if not codex_wait_for_sensor_ok(3.0):
      stop_reason = 3.0
    end
  end

  # 3. Guard is active before and during the no-contact XY motion.
  if stop_reason == 0.0 and not codex_guard_ok():
    stop_reason = 4.0
  end

  # 4. Search-like Z descent: mimics the final contact-search travel without
  # using a contact trigger. For Step1 no-contact geometry, use movel so UR's
  # planner handles smoothing; Step2 will tune speedl for interruptible contact.
  if stop_reason == 0.0:
    write_output_float_register(35, 4.0)
    local search_start = get_actual_tcp_pose()
    local target_search = p[search_start[0], search_start[1], search_start[2] - search_down_m, search_start[3], search_start[4], search_start[5]]
    if not codex_guard_ok():
      stop_reason = 4.0
    else:
      movel(target_search, a=0.030, v=search_speed_m_s, r=0.0)
      stopl(0.5)
      write_output_float_register(32, -search_down_m)
      if not codex_guard_ok():
        stop_reason = 4.0
      end
    end
  end

  # 5. Force-control placeholder: skipped for Step1.
  if stop_reason == 0.0:
    write_output_float_register(35, 5.0)
  end

  # 5.1. Execute the full XY dry-run line at fixed Z using movel.
  if stop_reason == 0.0:
    write_output_float_register(35, 5.1)
    local start_pose = get_actual_tcp_pose()
    local target_end = p[start_pose[0] + ux * path_length_m, start_pose[1] + uy * path_length_m, start_pose[2], start_pose[3], start_pose[4], start_pose[5]]
    write_output_float_register(31, 0.0)
    write_output_float_register(32, 0.0)
    write_output_float_register(33, 0.0)
    if not codex_guard_ok():
      stop_reason = 4.0
    else:
      movel(target_end, a=0.030, v=tangent_speed_m_s, r=0.0)
      stopl(0.5)
      write_output_float_register(31, path_length_m)
      if not codex_guard_ok():
        stop_reason = 4.0
      else:
        stop_reason = 1.0
      end
    end
  end

  # 6. Retract: keep XY unchanged, move +Z using movel.
  if stop_reason == 1.0:
    write_output_float_register(35, 6.0)
    local retract_start = get_actual_tcp_pose()
    local target_retract = p[retract_start[0], retract_start[1], retract_start[2] + retract_z_m, retract_start[3], retract_start[4], retract_start[5]]
    movel(target_retract, a=0.030, v=retract_speed_m_s, r=0.0)
    stopl(0.5)
    write_output_float_register(32, retract_z_m)
  end

  write_output_float_register(30, stop_reason)
  textmsg("codex step1 version 2026-06-05T00:52:09+08:00 stop reason:", stop_reason)
end

codex_step1_full_no_contact_pipeline()
