    else:
      stale_s = 0.0
      last_heartbeat = heartbeat
    end
    codex_echo_step4e(0.0)
    if stale_s > 0.100:
      return 2.0
    end
    local guard_reason = codex_step4e_guard_stop_reason()
    if guard_reason != 0.0:
      return guard_reason
    end
    if read_input_float_register(43) >= 0.5:
      return 0.0
    end
    sync()
    t = t + get_steptime()
  end
  return 12.0
end

def codex_v27_down_search(search_stage, near_stage, max_search_down_m, search_near_start_depth_m, search_runtime_limit_s, search_far_speed_m_s, search_near_speed_m_s):
