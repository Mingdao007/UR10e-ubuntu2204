    current_heartbeat = read_input_float_register(26)
    write_output_float_register(26, current_heartbeat)
    if read_input_float_register(27) > 0.5 and current_heartbeat != initial_heartbeat:
      return True
    end
    sync()
    t = t + get_steptime()
  end
  return False
end

