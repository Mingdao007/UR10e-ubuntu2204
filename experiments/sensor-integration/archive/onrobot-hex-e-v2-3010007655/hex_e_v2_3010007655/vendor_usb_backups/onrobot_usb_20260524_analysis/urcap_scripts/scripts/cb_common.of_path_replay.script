  #======    OnRobot F/T Path Replay    ======#
  
  textmsg("Path Replay script started...")
  OF_PATH_CACHE_ID=-1
  MATH_PI=d2r(180)
  readString=""
  enablePathReplay=True
  of_path_replay_running=False
  of_java_alive_thrd=0
  of_java_control_thrd=0
  def of_path_replay(pathID=OF_PATH_CACHE_ID,relative=False,homePose=ZEROPOSE,pathFrameID=0,pathFrameRPY=[0,0,0],speed=0.05,acc=0.5,limitSelectFlags=FALSE8D,limitAbsFlags=FALSE6D,limitValues=[0,0,0,0,0,0,0,0],popupmsg=True):
  sync()
  of_move_init(frameID=pathFrameID,frameRPY=pathFrameRPY,speed=speed,acc=acc)
  of_limit_start(ft_select=limitSelectFlags,ft_limits=limitValues,ft_abs=limitAbsFlags,frameID=pathFrameID,forFTControl=False,popupmsg=False)
  of_path_play(pathID,relative,homePose)
  global of_return=of_move_start_move(popupmsg=popupmsg)
  of_limit_stop()
  end 
  thread of_path_replay_thread():
  enter_critical
  of_path_replay_running=True
  exit_critical
  of_path_replay(pathID=of_path_replay_id,relative=of_path_replay_relative,homePose=of_path_replay_home_pose)
  enter_critical
  of_path_replay_running=False
  exit_critical
  end 
  thread OnRobotJavaAliveThread():
  local first_msg=True
  while(True):
  if of_portopened_javaSocket:
  if first_msg:
  local succ=socket_send_line("PATH_REPLAY","javaSocket")
  if succ:
  first_msg=False
  end 
  else:
  socket_send_line("RUNNING","javaSocket")
  end 
  end 
  of_wait_ms(100)
  sync()
  end 
  end 
  thread OnRobotJavaControlThread():
  while(True):
  if of_portopened_javaSocket:
  readString=socket_read_line("javaSocket",0)
  if length(readString)!=0:
  if OF_DEBUG_VAR:
  textmsg("ControlSocket readString: ",readString)
  end 
  end 
  if readString=="DISABLE_PATH_REPLAY":
  enablePathReplay=False
  end 
  end 
  sync()
  end 
  end 
  def closeAppEngine():
  if of_path_replay_running:
  kill of_path_replay_handler
  of_move_stop()
  end 
  kill of_java_alive_thrd
  kill of_java_control_thrd
  end 
  sync()
  of_java_alive_thrd=run OnRobotJavaAliveThread()
  sync()
  of_java_control_thrd=run OnRobotJavaControlThread()
  sync()
  of_path_replay_handler=run of_path_replay_thread()
  sync()
  while(enablePathReplay and of_path_replay_running):
  sync()
  end 
  closeAppEngine()
  sync()
  stopl(1.2)
  of_wait_ms(100)
  textmsg("Path Replay stopped.")
  halt
  
  #======    End of OnRobot F/T Path Replay    ======#
