  #======    OnRobot Gripper Set Width    ======#
  
  textmsg("Gripper Set Width script started...")
  MATH_PI=d2r(180)
  readString=""
  enableGripperSetWidth=True
  of_gripper_set_width_running=False
  of_java_alive_thrd=0
  of_java_control_thrd=0
  thread of_gripper_set_width_thread():
  enter_critical
  of_gripper_set_width_running=True
  exit_critical
  if(gripper_centering):
  of_gripper_centering_enable(1)
  end 
  of_gripper_set_width(width=gripper_width,force=gripper_force,blocking=True,depth_compensation=gripper_depth_compensation,popupmsg=True)
  if(gripper_centering):
  of_gripper_centering_disable()
  end 
  enter_critical
  of_gripper_set_width_running=False
  exit_critical
  end 
  thread OnRobotJavaAliveThread():
  local first_msg=True
  while(True):
  if of_portopened_javaSocket:
  if first_msg:
  local succ=socket_send_line("GRIPPER_SET_WIDTH","javaSocket")
  if succ:
  first_msg=False
  end 
  else:
  socket_send_line("RUNNING","javaSocket")
  end 
  end 
  of_wait_ms(100)
  sync()
  end 
  end 
  thread OnRobotJavaControlThread():
  while(True):
  if of_portopened_javaSocket:
  readString=socket_read_line("javaSocket",0)
  if length(readString)!=0:
  if OF_DEBUG_VAR:
  textmsg("ControlSocket readString: ",readString)
  end 
  end 
  if readString=="DISABLE":
  enableGripperSetWidth=False
  end 
  end 
  sync()
  end 
  end 
  def closeAppEngine():
  if of_gripper_set_width_running:
  kill of_gripper_set_width_handler
  of_gripper_stop()
  end 
  kill of_java_alive_thrd
  kill of_java_control_thrd
  end 
  sync()
  of_java_alive_thrd=run OnRobotJavaAliveThread()
  sync()
  of_java_control_thrd=run OnRobotJavaControlThread()
  sync()
  of_gripper_set_width_handler=run of_gripper_set_width_thread()
  sync()
  while(enableGripperSetWidth and of_gripper_set_width_running):
  sync()
  end 
  closeAppEngine()
  sync()
  stopl(1.2)
  of_wait_ms(100)
  textmsg("Gripper Set Width script stopped.")
  halt
  
  #======    End of OnRobot Gripper Set Width    ======#
