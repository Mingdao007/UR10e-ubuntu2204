{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ur10e:ursim:preparation-manifest:v1",
  "title": "UR10e URSim immutable preparation manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "spec_path",
    "spec_sha256",
    "status",
    "availability",
    "protocol_execution_performed",
    "claim_boundary",
    "runtime_environment",
    "lanes",
    "claims",
    "live_motion_authorized",
    "package_accepted",
    "live_accepted",
    "reproduction_complete"
  ],
  "properties": {
    "schema": {"const": "ur10e_ursim_preparation_manifest_v1"},
    "spec_path": {"type": "string", "minLength": 1},
    "spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"const": "blocked"},
    "availability": {"const": "unavailable"},
    "protocol_execution_performed": {"const": false},
    "claim_boundary": {"type": "string", "minLength": 1},
    "runtime_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "container_service",
        "container_socket",
        "socket_access",
        "image_inventory",
        "probe_source",
        "mutation_authorized"
      ],
      "properties": {
        "container_service": {"const": "inactive"},
        "container_socket": {"const": "active_enabled"},
        "socket_access": {"const": "denied_for_andy"},
        "image_inventory": {"const": "unverified_no_socket_permission"},
        "probe_source": {"type": "string", "minLength": 1},
        "mutation_authorized": {"const": false}
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/lane"}
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p0_ursim_protocol_pass",
        "direct_torque_ursim_software_pass"
      ],
      "properties": {
        "p0_ursim_protocol_pass": {"const": false},
        "direct_torque_ursim_software_pass": {"const": false}
      }
    },
    "live_motion_authorized": {"const": false},
    "package_accepted": {"const": false},
    "live_accepted": {"const": false},
    "reproduction_complete": {"const": false}
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256", "verified"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "verified": {"const": true}
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "claim_id",
        "polyscope_version",
        "image",
        "bindings",
        "static_contract",
        "required_runtime_checks",
        "runtime_status",
        "protocol_pass",
        "status",
        "blockers"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "claim_id": {
          "enum": [
            "p0_ursim_protocol_pass",
            "direct_torque_ursim_software_pass"
          ]
        },
        "polyscope_version": {
          "type": "object",
          "additionalProperties": false,
          "required": ["constraint", "value"],
          "properties": {
            "constraint": {"const": "exact"},
            "value": {"type": "string", "pattern": "^5\\.[0-9]+(\\.[0-9]+){1,2}$"}
          }
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "digest_required",
            "digest",
            "reference",
            "availability"
          ],
          "properties": {
            "digest_required": {"const": true},
            "digest": {"type": "null"},
            "reference": {"type": "null"},
            "availability": {"const": "unverified_no_socket_permission"}
          }
        },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/binding"}
        },
        "static_contract": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"const": true}
        },
        "required_runtime_checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "runtime_status": {"const": "unavailable"},
        "protocol_pass": {"const": false},
        "status": {"const": "blocked"},
        "blockers": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
