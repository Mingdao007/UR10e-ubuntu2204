FROM ghcr.io/astral-sh/uv:0.9.30 AS uv
FROM ros:humble-ros-base-jammy@sha256:5c793b92e0b12d6babb438cb20eed7766495fde6419a21e3d2e918464f09dc17

COPY --from=uv /uv /uvx /bin/

WORKDIR /opt/step5d-control
COPY experiments/tase-contact-reproduction/pyproject.toml ./pyproject.toml
COPY experiments/tase-contact-reproduction/uv.lock ./uv.lock
RUN uv sync --frozen --only-group control

WORKDIR /opt/step5d-optimizer
COPY experiments/tase-contact-reproduction/pyproject.toml ./pyproject.toml
COPY experiments/tase-contact-reproduction/uv.lock ./uv.lock
RUN uv sync --frozen --only-group optimizer

ENV HOME=/tmp/step5d-home \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONNOUSERSITE=1 \
    STEP5D_OCI_NETWORK_MODE=none \
    STEP5D_OCI_REPOSITORY_MODE=read_only
WORKDIR /workspace/experiments/tase-contact-reproduction
ENTRYPOINT ["/usr/bin/python3.10", "/workspace/ci/step5d-v3/run_oci_gate.py"]
