# ROS 2 / colcon generated files
build/
install/
log/

# Python generated files
__pycache__/
*.py[cod]

# Large runtime recordings are archived manually unless explicitly selected.
*.db3
*.mcap
*.bag
*.zstd

# Large raw force/torque captures stay local unless Git LFS is explicitly
# configured for the archive branch.
experiments/**/run_*/**/*.csv
experiments/**/onrobot_tcpdaq/*.csv
experiments/**/artifacts/**/*.tar.gz
experiments/**/worktree/
ft_sensor/onrobot/hex_e_v2_3010007655/vendor_usb_backups/**/Compute_Box_update/*.osu

# OnRobot HEX device-root data policy.
# Track small docs/tools/manifests intentionally, but keep raw photos and
# measurement outputs out of git.
ft_sensor/onrobot/hex_e_v2_3010007655/photos_raw/
ft_sensor/onrobot/hex_e_v2_3010007655/latest_connection_photos/
ft_sensor/onrobot/hex_e_v2_3010007655/assets/thumbnails/
ft_sensor/onrobot/hex_e_v2_3010007655/assets/contact_sheets/
ft_sensor/onrobot/hex_e_v2_3010007655/measurements/**/*.csv
ft_sensor/onrobot/hex_e_v2_3010007655/measurements/**/*.jsonl
ft_sensor/onrobot/hex_e_v2_3010007655/measurements/**/*.png
ft_sensor/onrobot/hex_e_v2_3010007655/measurements/**/*.log

# Local editor/cache files
.vscode/
.DS_Store
*.swp
*~

# Obsidian local window state
.obsidian/workspace.json
.obsidian/workspace-mobile.json
ur10e/.obsidian/
.trash/
