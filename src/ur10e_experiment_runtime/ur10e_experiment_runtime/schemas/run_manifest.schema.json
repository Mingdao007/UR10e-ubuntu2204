{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/ur10e/run-manifest-v1.schema.json",
  "title": "UR10e RunManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "experiment_fingerprint",
    "run_uid",
    "run_identity_sha256",
    "run_nonce",
    "campaign_uid",
    "lane",
    "candidate",
    "trial_overlay",
    "control_candidate_uid",
    "authorization_ref",
    "fingerprints",
    "resource_locks",
    "state_chain",
    "controller_readback",
    "outcome",
    "metric_role",
    "oracle_status",
    "observer_status",
    "ack",
    "closure",
    "publication",
    "optimizer_eligible",
    "objective",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "ur10e.run_manifest/v1"},
    "experiment_id": {"$ref": "#/$defs/identifier"},
    "experiment_fingerprint": {"$ref": "#/$defs/sha256"},
    "run_uid": {"$ref": "#/$defs/sha256"},
    "run_identity_sha256": {"$ref": "#/$defs/sha256"},
    "run_nonce": {"$ref": "#/$defs/sha256"},
    "campaign_uid": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "lane": {
      "enum": ["offline", "replay", "gazebo", "ursim", "hil", "live_autotune"]
    },
    "candidate": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["p_gain", "i_gain", "damping"],
          "properties": {
            "p_gain": {"type": "number", "exclusiveMinimum": 0},
            "i_gain": {"type": "number", "minimum": 0},
            "damping": {"type": "number", "exclusiveMinimum": 0}
          }
        }
      ]
    },
    "trial_overlay": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/autotune_candidate"}
      ]
    },
    "control_candidate_uid": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "authorization_ref": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "fingerprints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pre", "post"],
      "properties": {
        "pre": {"$ref": "#/$defs/sha256"},
        "post": {"$ref": "#/$defs/sha256"}
      }
    },
    "resource_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "acquired", "release_policy"],
      "properties": {
        "requested": {
          "type": "array",
          "items": {"$ref": "#/$defs/exclusive_resource"},
          "uniqueItems": true
        },
        "acquired": {
          "type": "array",
          "items": {"$ref": "#/$defs/exclusive_resource"},
          "uniqueItems": true
        },
        "release_policy": {
          "const": "before_final_manifest_after_execution_receipt"
        }
      }
    },
    "state_chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_count", "head_sha256"],
      "properties": {
        "record_count": {"type": "integer", "minimum": 1},
        "head_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "controller_readback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controller_id", "verified", "sha256"],
      "properties": {
        "controller_id": {"$ref": "#/$defs/identifier"},
        "verified": {"type": "boolean"},
        "sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "reason"],
      "properties": {
        "classification": {
          "enum": [
            "offline_scaffold",
            "valid_parameter_observation",
            "infrastructure_failure",
            "startup_failure",
            "model_mismatch",
            "safety_stop",
            "observer_gap",
            "operator_stop",
            "code_contract_failure"
          ]
        },
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "metric_role": {
      "enum": ["trainable_objective", "diagnostic_only", "unavailable"]
    },
    "oracle_status": {"enum": ["credible", "failed", "unavailable"]},
    "observer_status": {"enum": ["complete", "incomplete", "unavailable"]},
    "ack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ack_uid", "consumed", "receipt_sha256"],
      "properties": {
        "ack_uid": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "consumed": {"type": "boolean"},
        "receipt_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["post_ack_verified", "receipt_sha256"],
      "properties": {
        "post_ack_verified": {"type": "boolean"},
        "receipt_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unique", "identity_sha256"],
      "properties": {
        "unique": {"type": "boolean"},
        "identity_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "optimizer_eligible": {"type": "boolean"},
    "objective": {
      "oneOf": [
        {"type": "number"},
        {"type": "null"}
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "sha256"],
        "properties": {
          "kind": {"$ref": "#/$defs/identifier"},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "minLength": 1,
      "maxLength": 128
    },
    "autotune_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p_gain", "i_gain", "damping"],
      "properties": {
        "p_gain": {"type": "number", "exclusiveMinimum": 0},
        "i_gain": {"type": "number", "minimum": 0},
        "damping": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "exclusive_resource": {
      "enum": ["live_writer", "visible_gazebo", "formal_timing"]
    }
  }
}
