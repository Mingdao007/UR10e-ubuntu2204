    return stop_var
    end
    def of_warning(status_flag,message,title,isPopupNeeded=False,is_shown=False):
    if(status_flag):
    if(not is_shown):
    if(isPopupNeeded):
    popup(message,title=title,warning=True,blocking=False)
    else:
    textmsg(title+": ",message)
