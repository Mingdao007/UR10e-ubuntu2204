    if(check_zero(compareFT[3],tx,zeroVal)):
    is_above_the_threshold=True
    end
    if(check_zero(compareFT[4],ty,zeroVal)):
    is_above_the_threshold=True
    end
    if(check_zero(compareFT[5],tz,zeroVal)):
    is_above_the_threshold=True
    end
    return is_above_the_threshold
