    local bF=pose_trans(act_transform,p[sFT[0],sFT[1],sFT[2],0,0,0])
    local bT=pose_trans(act_transform,p[sFT[3],sFT[4],sFT[5],0,0,0])
    bFT=[bF[0],bF[1],bF[2],bT[0],bT[1],bT[2]]
    tFT=[Fx,Fy,Fz,Tx,Ty,Tz]
