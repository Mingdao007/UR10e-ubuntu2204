    sync()
    if speedCP==99999:
    speedCP=speed
    end
    def invert_offset(o):
    local i=0
    local r=p[0,0,0,0,0,0]
    while(i<6):
    if(o[i]!=0):
    r[i]=-o[i]
    else:
    r[i]=0
    end
    i=i+1
    end
    return r
    end
